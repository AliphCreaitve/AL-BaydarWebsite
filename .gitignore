node_modules/

# ---------------------------------------------------------------------------
# assets/ holds source material and intermediates. The big generated files
# here are regenerated by the scripts, so they stay out of git:
#
#   npm install
#   node scripts/build-walkthrough.mjs
#   node scripts/process-video.mjs assets/walkthrough.mp4
#   node scripts/process-video.mjs assets/demo.mp4
# ---------------------------------------------------------------------------
assets/frames/
assets/walkthrough.mp4
assets/*-play.mp4
assets/*-scrub.*
assets/*-poster.jpg
assets/*-lastframe.png

# ---------------------------------------------------------------------------
# demo/assets/ is deliberately NOT ignored. The host serves demo/ as the web
# root, so that directory is the deployed site and has to be self-contained —
# if the encoded video isn't committed, the deploy has nothing to serve.
# ---------------------------------------------------------------------------

# Tracked as source material, not derived:
#   shots/           the original 12 MP photographs
#   assets/demo.mp4  the original AI-generated clip
