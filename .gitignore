node_modules/

# ---------------------------------------------------------------------------
# Derived video assets. All of these are regenerated by the scripts, so they
# stay out of git — committing them would add ~120 MB, and a fresh copy on
# every re-encode.
#
#   npm install
#   node scripts/build-walkthrough.mjs
#   node scripts/process-video.mjs assets/walkthrough.mp4
#   node scripts/process-video.mjs assets/demo.mp4
# ---------------------------------------------------------------------------
assets/frames/
assets/walkthrough.mp4
assets/*-play.mp4
assets/*-scrub.*
assets/*-poster.jpg
assets/*-lastframe.png

# Kept in git as source material, not derived:
#   shots/           the original 12 MP photographs
#   assets/demo.mp4  the original AI-generated clip
